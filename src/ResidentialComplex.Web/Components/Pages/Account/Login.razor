@page "/Account/Login"
@layout ResidentialComplex.Web.Components.Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">ورود به سیستم</MudText>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@ErrorMessage</MudAlert>
        }
        <form method="post" action="/Account/LoginPost">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="UserName" value="@loginModel.UserName" />
            <input type="hidden" name="Password" value="@loginModel.Password" />
            <input type="hidden" name="RememberMe" value="@loginModel.RememberMe.ToString().ToLowerInvariant()" />
            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="loginModel.UserName" Label="نام کاربری" Variant="Variant.Outlined" Required="true" />
                <MudTextField T="string" @bind-Value="loginModel.Password" Label="رمز عبور" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" />
                <MudCheckBox T="bool" @bind-Value="loginModel.RememberMe" Label="مرا به خاطر بسپار" Color="Color.Primary" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Login">
                    ورود
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>
</MudContainer>
