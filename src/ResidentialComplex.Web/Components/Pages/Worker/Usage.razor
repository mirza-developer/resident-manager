@page "/worker/usage"
@attribute [Authorize(Roles = "Administrator,Worker")]

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudText Typo="Typo.h4">ثبت مصرف ماهانه</MudText>
    <HelpButton PageKey="usage" />
</MudStack>

@* fixed-height slot so the page does not jump when the loading bar appears *@
<div style="height: 4px" class="mb-2">
    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
</div>

<MudPaper Class="pa-3 mb-3">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="6" md="2">
            <MudNumericField T="int" @bind-Value="year" Label="سال" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="int" @bind-Value="month" Label="ماه" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (var currentMonth = 1; currentMonth <= 12; currentMonth++)
                {
                    var m = currentMonth;
                    <span @key="m" style="display:contents"><MudSelectItem T="int" Value="@m">@GetMonthName(m)</MudSelectItem></span>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">
                نمایش
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudTextField T="string" @bind-Value="searchText" Label="جستجوی واحد" Placeholder="نام یا شماره واحد..." Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Clearable="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!usageItems.Any() && loaded)
{
    <div><MudAlert Severity="Severity.Warning">آیتم مالی گروه‌بندی فعالی وجود ندارد.</MudAlert></div>
}

@if (usageItems.Any())
{
    <div>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            «کنتور قبلی» از ماه گذشته خودکار پر می‌شود؛ فقط «کنتور فعلی» را وارد و ذخیره کنید. هر آیتم مالی یک زبانه جداست و عدد روی زبانه، تعداد واحدهای ثبت‌نشده است.
        </MudAlert>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
            @foreach (var usageItem in usageItems)
            {
                var item = usageItem;
                <MudTabPanel @key="item.FinancialItemId" Text="@item.Title">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                ثبت‌شده: @GetSavedCount(item) از @item.Rows.Count
                            </MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                جمع مصرف: @item.Rows.Sum(r => r.UsageCount).ToString("N0")
                            </MudChip>
                        </MudStack>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@(() => SaveAllForItemAsync(item.FinancialItemId))">
                            ذخیره همه
                        </MudButton>
                    </MudStack>

                    @* the grid has a fixed height: the rows scroll inside it, the header stays visible, the page never grows *@
                    <MudDataGrid T="UsageRow" Items="@item.Rows" QuickFilter="@MatchesSearch" Height="@GridHeight" FixedHeader="true"
                                 RowsPerPage="25" Hover="true" Dense="true">
                        <Columns>
                            <PropertyColumn Property="x => x.HouseTitle" Title="واحد" />
                            <TemplateColumn Title="کنتور قبلی (حد پایین)" Sortable="false">
                                <CellTemplate>
                                    <MudNumericField T="int" Value="@context.Item.PreviousReading"
                                                     ValueChanged="@((int v) => OnPreviousReadingChanged(context.Item, v))"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" Style="min-width: 120px" />
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="کنتور فعلی (حد بالا)" Sortable="false">
                                <CellTemplate>
                                    <MudNumericField T="int" Value="@context.Item.CurrentReading"
                                                     ValueChanged="@((int v) => OnCurrentReadingChanged(context.Item, v))"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" Style="min-width: 120px" />
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="مصرف" Sortable="false">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Color="@(context.Item.CurrentReading < context.Item.PreviousReading ? Color.Error : Color.Default)">
                                        @context.Item.UsageCount.ToString("N0")
                                    </MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="وضعیت" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    @if (context.Item.ExistingUsageId.HasValue)
                                    {
                                        <MudTooltip Text="ثبت شده"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /></MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="هنوز ثبت نشده"><MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Default" Size="Size.Small" /></MudTooltip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveUsageAsync(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText>واحدی با این مشخصات یافت نشد.</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudDataGridPager T="UsageRow" PageSizeOptions="@pageSizeOptions" />
                        </PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            }
        </MudTabs>
    </div>
}
