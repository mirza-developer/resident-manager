@page "/worker/usage"
@attribute [Authorize(Roles = "Administrator,Worker")]

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">ثبت مصرف ماهانه</MudText>
        <HelpButton PageKey="usage" />
    </MudStack>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">
        بارگذاری
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudNumericField T="int" @bind-Value="year" Label="سال" Variant="Variant.Outlined" Min="1" HideSpinButtons="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="int" @bind-Value="month" Label="ماه" Variant="Variant.Outlined">
                @for (var currentMonth = 1; currentMonth <= 12; currentMonth++)
                {
                    <MudSelectItem T="int" Value="@currentMonth">@GetMonthName(currentMonth)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">
                نمایش اطلاعات
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!usageItems.Any() && loaded)
{
    <MudAlert Severity="Severity.Warning">آیتم مالی گروه‌بندی فعالی وجود ندارد.</MudAlert>
}

@foreach (var usageItem in usageItems)
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            <MudText Typo="Typo.h6">@usageItem.Title</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => SaveAllForItemAsync(usageItem.FinancialItemId))">
                ذخیره همه
            </MudButton>
        </MudStack>

        <MudDataGrid T="UsageRow" Items="@usageItem.Rows" RowsPerPage="10" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.HouseTitle" Title="واحد" />
                <TemplateColumn Title="مقدار مصرف">
                    <CellTemplate>
                        <MudNumericField T="int" @bind-Value="context.Item.UsageCount" Variant="Variant.Outlined" HideSpinButtons="true" Min="0" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveUsageAsync(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="UsageRow" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
}
