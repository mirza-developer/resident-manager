@page "/worker/usage"
@using Microsoft.AspNetCore.Authorization
@using ResidentialComplex.Application.Interfaces
@using ResidentialComplex.Domain.Entities
@attribute [Authorize(Roles = "Worker")]
@inject IMonthlyUsageRepository UsageRepo
@inject IHouseRepository HouseRepo

<h4>ثبت مصرف ماهانه</h4>
<HelpButton PageKey="usage" />

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-2">
                <label class="form-label">سال</label>
                <input type="number" @bind="year" class="form-control" />
            </div>
            <div class="col-md-3 mb-2">
                <label class="form-label">ماه</label>
                <input type="number" @bind="month" class="form-control" min="1" max="12" />
            </div>
            <div class="col-md-3 mb-2 d-flex align-items-end">
                <button class="btn btn-primary" @onclick="Load">بارگذاری</button>
            </div>
        </div>
    </div>
</div>

@if (houses.Any())
{
    <table class="table table-bordered">
        <thead><tr><th>واحد</th><th>مقدار مصرف</th><th>عملیات</th></tr></thead>
        <tbody>
            @foreach (var h in houses)
            {
                <tr>
                    <td>@h.Title</td>
                    <td><input type="number" @bind="usageCounts[h.Id]" class="form-control" style="max-width:150px" /></td>
                    <td><button class="btn btn-sm btn-primary" @onclick="() => SaveUsage(h.Id)">ذخیره</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}

@code {
    private int year = DateTime.Now.Year;
    private int month = DateTime.Now.Month;
    private List<House> houses = new();
    private Dictionary<int, int> usageCounts = new();
    private string? message;

    private async Task Load()
    {
        houses = await HouseRepo.GetActiveHousesAsync();
        var usages = await UsageRepo.GetByMonthYearAsync(year, month);
        usageCounts = houses.ToDictionary(h => h.Id, h => usages.FirstOrDefault(u => u.HouseId == h.Id)?.UsageCount ?? 0);
    }

    private async Task SaveUsage(int houseId)
    {
        var existing = await UsageRepo.GetByHouseMonthYearAsync(houseId, year, month);
        if (existing != null)
        {
            existing.UsageCount = usageCounts[houseId];
            await UsageRepo.UpdateAsync(existing);
        }
        else
        {
            await UsageRepo.AddAsync(new MonthlyUsage { HouseId = houseId, Year = year, Month = month, UsageCount = usageCounts[houseId] });
        }
        message = "ذخیره شد.";
    }
}
