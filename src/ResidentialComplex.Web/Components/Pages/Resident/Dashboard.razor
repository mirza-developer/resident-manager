@page "/resident/dashboard"
@attribute [Authorize(Roles = "Administrator,Resident")]
@using ResidentialComplex.Domain.Entities
@using ResidentialComplex.Domain.Enums

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudText Typo="Typo.h4">پنل ساکن</MudText>
    <HelpButton PageKey="residentDashboard" />
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History" Href="/resident/payments">
        تاریخچه پرداخت‌های آنلاین
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

@if (house is null)
{
    <div><MudAlert Severity="Severity.Warning">واحدی برای حساب کاربری شما تعریف نشده است.</MudAlert></div>
}
else
{
    <div>
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">اطلاعات واحد: @house.Title</MudText>
            <MudText Typo="Typo.subtitle1" Class="mt-2">
                بدهی فعلی:
                <MudText Inline="true" Color="@(house.CurrentDebt > 0 ? Color.Error : Color.Success)">
                    @house.CurrentDebt.ToString("N0") ریال
                </MudText>
            </MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">تاریخچه قبوض</MudText>
            <MudDataGrid T="Bill" Items="@bills" RowsPerPage="10" Hover="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.Year" Title="سال" />
                    <TemplateColumn Title="ماه">
                        <CellTemplate>@GetMonthName(context.Item.Month)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="مبلغ">
                        <CellTemplate>@context.Item.TotalAmount.ToString("N0")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="وضعیت">
                        <CellTemplate>@GetStatusLabel(context.Item.Status)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="پرداخت" Sortable="false" Filterable="false">
                        <CellTemplate>
                            @if (context.Item.Status == BillStatus.Approved && CanPayOnline)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Payment"
                                           Disabled="@(payingBillId.HasValue)"
                                           OnClick="@(() => PayOnlineAsync(context.Item))">
                                    @(payingBillId == context.Item.Id ? "در حال اتصال..." : "پرداخت آنلاین")
                                </MudButton>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText>قبضی برای نمایش وجود ندارد.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="Bill" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>
    </div>
}
