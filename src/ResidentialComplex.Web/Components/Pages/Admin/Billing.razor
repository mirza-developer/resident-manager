@page "/admin/billing"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ResidentialComplex.Application.Helpers
@using ResidentialComplex.Application.Interfaces
@using ResidentialComplex.Application.Services
@using ResidentialComplex.Domain.Entities
@using ResidentialComplex.Domain.Enums
@using ResidentialComplex.Persistence
@attribute [Authorize(Roles = "Administrator")]
@inject BillingService BillingService
@inject IFinancialItemRepository FinancialItemRepo
@inject IBillRepository BillRepo
@inject IHouseRepository HouseRepo
@inject IMonthlyUsageRepository UsageRepo
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<h4>صورتحساب ماهانه</h4>
<HelpButton PageKey="billing" />

<div class="card mb-3">
    <div class="card-body">
        <h5>تولید صورتحساب</h5>
        <div class="row">
            <div class="col-md-3 mb-2">
                <label class="form-label">سال</label>
                <input type="number" @bind="year" class="form-control" />
            </div>
            <div class="col-md-3 mb-2">
                <label class="form-label">ماه</label>
                <select @bind="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthNum = m;
                        <option value="@monthNum">@PersianCalendarHelper.GetMonthName(monthNum)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary" @onclick="CheckUsageStatus">بررسی وضعیت مصرف</button>
            </div>
        </div>

        @if (missingUsageItems.Any())
        {
            <div class="alert alert-warning mt-3">
                <strong>هشدار:</strong> برای آیتم‌های گروه‌بندی زیر، مقادیر مصرف برای تمام واحدها ثبت نشده است. تا زمانی که مصرف ثبت نشود، امکان تولید صورتحساب وجود ندارد.
                <ul class="mb-0 mt-2">
                    @foreach (var item in missingUsageItems)
                    {
                        <li>@item.Title — @item.MissingCount واحد بدون مقدار مصرف</li>
                    }
                </ul>
            </div>
        }

        @if (activeItems.Any())
        {
            <h6 class="mt-3">مبلغ نهایی هر آیتم مالی:</h6>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 30%">عنوان</th>
                        <th style="width: 20%">نوع دوره</th>
                        <th style="width: 20%">نوع محاسبه</th>
                        <th style="width: 25%">مبلغ (ریال)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNum = 0; }
                    @foreach (var fi in activeItems)
                    {
                        rowNum++;
                        <tr>
                            <td>@rowNum</td>
                            <td>@fi.Title</td>
                            <td>@GetPeriodLabel(fi.PeriodType)</td>
                            <td>@GetCalcLabel(fi.CalculationType)</td>
                            <td>
                                @if (fi.CalculationType == CalculationType.Grouping)
                                {
                                    <span class="text-muted fst-italic">تعرفه‌ای (محاسبه از مصرف)</span>
                                }
                                else
                                {
                                    <input type="number" class="form-control" @bind="finalAmounts[fi.Id]" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <button type="button" class="btn btn-primary mt-2" @onclick="Generate" disabled="@missingUsageItems.Any()">تولید صورتحساب</button>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-info") mt-2">@message</div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>قبوض @PersianCalendarHelper.FormatYearMonth(year, month)</h5>
        <button type="button" class="btn btn-info mb-2" @onclick="LoadBills">بارگذاری</button>
        @if (bills.Any(b => b.Status == BillStatus.Draft))
        {
            <button type="button" class="btn btn-success mb-2" @onclick="ApproveBills">تایید همه قبوض پیش‌نویس</button>
        }
        @if (bills.Any())
        {
        <table class="table table-striped table-bordered">
            <thead><tr><th>واحد</th><th>مبلغ کل</th><th>وضعیت</th><th>عملیات</th></tr></thead>
            <tbody>
                @foreach (var bill in bills)
                {
                    <tr>
                        <td>@bill.House?.Title</td>
                        <td>
                            @if (bill.Status == BillStatus.Draft)
                            {
                                <input type="number" class="form-control form-control-sm" value="@bill.TotalAmount"
                                       @onchange="(e) => UpdateBillAmount(bill, e)" style="max-width: 160px;" />
                            }
                            else
                            {
                                @bill.TotalAmount.ToString("N0")
                            }
                        </td>
                        <td>@GetStatusLabel(bill.Status)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-info me-1" @onclick="() => ToggleDetail(bill.Id)">جزئیات</button>
                            @if (bill.Status == BillStatus.Approved)
                            {
                                <button type="button" class="btn btn-sm btn-success" @onclick="() => Pay(bill.Id)">ثبت پرداخت</button>
                            }
                        </td>
                    </tr>
                    @if (expandedBillId == bill.Id && bill.BillItems != null)
                    {
                        <tr>
                            <td colspan="4" class="bg-light">
                                <table class="table table-sm table-bordered mb-0">
                                    <thead>
                                        <tr class="table-secondary">
                                            <th>آیتم مالی</th>
                                            <th>نوع محاسبه</th>
                                            <th>مبلغ (ریال)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bi in bill.BillItems)
                                        {
                                            <tr>
                                                <td>@(bi.FinancialItem?.Title ?? bi.Description)</td>
                                                <td>@(bi.FinancialItem != null ? GetCalcLabel(bi.FinancialItem.CalculationType) : "-")</td>
                                                <td>@bi.Amount.ToString("N0")</td>
                                            </tr>
                                        }
                                        <tr class="fw-bold">
                                            <td colspan="2">جمع کل</td>
                                            <td>@bill.BillItems.Sum(bi => bi.Amount).ToString("N0")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        }
    </div>
</div>

@code {
    private int year = PersianCalendarHelper.GetCurrentYear();
    private int month = PersianCalendarHelper.GetCurrentMonth();
    private List<FinancialItem> activeItems = new();
    private Dictionary<int, decimal> finalAmounts = new();
    private List<Bill> bills = new();
    private string? message;
    private bool isError;
    private List<MissingUsageInfo> missingUsageItems = new();
    private int? expandedBillId;

    protected override async Task OnInitializedAsync()
    {
        activeItems = await FinancialItemRepo.GetActiveAsync();
        foreach (var fi in activeItems)
            finalAmounts[fi.Id] = fi.TotalAmount ?? 0;
        await CheckUsageStatus();
    }

    private async Task CheckUsageStatus()
    {
        missingUsageItems.Clear();
        var groupingItems = activeItems.Where(fi => fi.CalculationType == CalculationType.Grouping && IsApplicable(fi)).ToList();
        if (!groupingItems.Any()) return;

        var activeHouses = await HouseRepo.GetActiveHousesAsync();
        if (activeHouses.Count == 0) return;

        var usages = await UsageRepo.GetByMonthYearAsync(year, month);
        var usageSet = usages
            .Select(u => (u.HouseId, u.FinancialItemId))
            .ToHashSet();

        foreach (var fi in groupingItems)
        {
            var missingCount = activeHouses.Count(h => !usageSet.Contains((h.Id, fi.Id)));
            if (missingCount > 0)
            {
                missingUsageItems.Add(new MissingUsageInfo { Title = fi.Title, MissingCount = missingCount });
            }
        }
    }

    private async Task<(string userId, string userName)> GetCurrentUser()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        return (user?.Id ?? "", user?.UserName ?? "");
    }

    private async Task Generate()
    {
        await CheckUsageStatus();
        if (missingUsageItems.Any())
        {
            message = "ابتدا مقادیر مصرف تمام آیتم‌های گروه‌بندی باید توسط کاربر کارگر ثبت شود.";
            isError = true;
            return;
        }

        var (userId, userName) = await GetCurrentUser();
        try
        {
            isError = false;
            var generated = await BillingService.GenerateBillsAsync(year, month, finalAmounts, userId, userName);
            message = $"{generated.Count} قبض تولید شد.";
            await LoadBills();
        }
        catch (Exception ex) { message = ex.Message; isError = true; }
    }

    private async Task LoadBills() => bills = await BillRepo.GetByMonthYearAsync(year, month);

    private async Task ApproveBills()
    {
        var (userId, userName) = await GetCurrentUser();
        await BillingService.ApproveBillsAsync(year, month, userId, userName);
        await LoadBills();
        isError = false;
        message = "قبوض تایید شدند.";
    }

    private async Task Pay(int billId)
    {
        var (userId, userName) = await GetCurrentUser();
        await BillingService.RecordPaymentAsync(billId, userId, userName);
        await LoadBills();
    }

    private void ToggleDetail(int billId)
    {
        expandedBillId = expandedBillId == billId ? null : billId;
    }

    private async Task UpdateBillAmount(Bill bill, ChangeEventArgs e)
    {
        if (bill.Status != BillStatus.Draft) return;
        if (decimal.TryParse(e.Value?.ToString(), out var newAmount))
        {
            bill.TotalAmount = newAmount;
            await BillRepo.UpdateAsync(bill);
            await LoadBills();
        }
    }

    private static bool IsApplicable(FinancialItem fi)
    {
        if (!fi.IsActive) return false;
        if (fi.PeriodType == PeriodType.Installment && fi.NumberOfInstallments.HasValue && fi.InstallmentsBilled >= fi.NumberOfInstallments.Value)
            return false;
        return true;
    }

    private static string GetStatusLabel(BillStatus s) => s switch { BillStatus.Draft => "پیش‌نویس", BillStatus.Approved => "تایید شده", BillStatus.Paid => "پرداخت شده", _ => "" };
    private static string GetPeriodLabel(PeriodType pt) => pt switch { PeriodType.Once => "یکبار", PeriodType.Permanent => "دائمی", PeriodType.Installment => "اقساط", _ => "" };
    private static string GetCalcLabel(CalculationType ct) => ct switch { CalculationType.EqualDivision => "تقسیم مساوی", CalculationType.Grouping => "گروه‌بندی", _ => "" };

    private class MissingUsageInfo
    {
        public string Title { get; set; } = "";
        public int MissingCount { get; set; }
    }
}
