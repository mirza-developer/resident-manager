@page "/admin/billing"
@attribute [Authorize(Roles = "Administrator")]
@using ResidentialComplex.Domain.Entities
@using ResidentialComplex.Domain.Enums

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">صورتحساب ماهانه</MudText>
        <HelpButton PageKey="billing" />
    </MudStack>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="InitializeDataAsync">
        بروزرسانی
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-3">تولید صورتحساب</MudText>
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudNumericField T="int" @bind-Value="year" Label="سال" Variant="Variant.Outlined" Min="1" HideSpinButtons="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="int" @bind-Value="month" Label="ماه" Variant="Variant.Outlined">
                @for (var currentMonth = 1; currentMonth <= 12; currentMonth++)
                {
                    <text><MudSelectItem T="int" Value="@currentMonth">@GetMonthName(currentMonth)</MudSelectItem></text>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex align-center gap-2 flex-wrap">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Search" OnClick="CheckUsageStatusAsync">
                بررسی وضعیت مصرف
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(missingUsageItems.Any() || missingTiersItems.Any())" OnClick="GenerateAsync">
                تولید صورتحساب
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (missingTiersItems.Any())
    {
        <div>
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                آیتم‌های گروه‌بندی زیر تعرفه ندارند: @string.Join("، ", missingTiersItems)
            </MudAlert>
        </div>
    }

    @if (missingUsageItems.Any())
    {
        <div>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                @foreach (var item in missingUsageItems)
                {
                    <div>@item.Title — @item.MissingCount واحد بدون مقدار مصرف</div>
                }
            </MudAlert>
        </div>
    }

    @if (financialAmountRows.Any())
    {
        <div>
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">مبلغ نهایی هر آیتم مالی</MudText>
            <MudDataGrid T="FinancialItemAmountRow" Items="@financialAmountRows" RowsPerPage="10" Hover="true" Dense="true">
                <Columns>
                    <TemplateColumn Title="#">
                        <CellTemplate>@(financialAmountRows.IndexOf(context.Item) + 1)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Title" Title="عنوان" />
                    <TemplateColumn Title="نوع دوره">
                        <CellTemplate>@GetPeriodLabel(context.Item.PeriodType)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="نوع محاسبه">
                        <CellTemplate>@GetCalcLabel(context.Item.CalculationType)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="مبلغ (ریال)">
                        <CellTemplate>
                            @if (context.Item.CalculationType == CalculationType.Grouping)
                            {
                                <text><MudText Color="Color.Secondary">تعرفه‌ای (محاسبه از مصرف)</MudText></text>
                            }
                            else
                            {
                                <text><MudNumericField T="decimal" @bind-Value="context.Item.Amount" Variant="Variant.Outlined" Format="N0" HideSpinButtons="true" Immediate="false" /></text>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="FinancialItemAmountRow" />
                </PagerContent>
            </MudDataGrid>
        </div>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
        <MudText Typo="Typo.h6">قبوض @FormatYearMonth(year, month)</MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadBillsAsync">بارگذاری</MudButton>
            @if (bills.Any(x => x.Status == BillStatus.Draft))
            {
                <text><MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveBillsAsync">تایید قبوض پیش‌نویس</MudButton></text>
            }
        </MudStack>
    </MudStack>

    <MudDataGrid T="Bill" Items="@bills" Filterable="true" SortMode="SortMode.Multiple" RowsPerPage="10" Hover="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.House!.Title" Title="واحد" />
            <TemplateColumn Title="مبلغ کل">
                <CellTemplate>
                    @if (context.Item.Status == BillStatus.Draft)
                    {
                        <text><MudNumericField T="decimal" Value="@context.Item.TotalAmount" ValueChanged="@((decimal value) => UpdateBillAmountAsync(context.Item, value))" Variant="Variant.Outlined" Format="N0" HideSpinButtons="true" Immediate="false" /></text>
                    }
                    else
                    {
                        @context.Item.TotalAmount.ToString("N0")
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="وضعیت">
                <CellTemplate>@GetStatusLabel(context.Item.Status)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => ShowBillDetails(context.Item.Id))" />
                    @if (context.Item.Status == BillStatus.Approved)
                    {
                        <text><MudIconButton Icon="@Icons.Material.Filled.Payments" Color="Color.Success" Size="Size.Small" OnClick="@(() => PayAsync(context.Item.Id))" /></text>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>قبضی برای این دوره پیدا نشد.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="Bill" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@if (selectedBill is not null)
{
    <div>
        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">جزئیات قبض واحد @selectedBill.House?.Title</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="ClearBillDetails">بستن جزئیات</MudButton>
            </MudStack>
            <MudDataGrid T="BillItem" Items="@selectedBill.BillItems" RowsPerPage="10" Hover="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.FinancialItem!.Title" Title="آیتم مالی" />
                    <TemplateColumn Title="نوع محاسبه">
                        <CellTemplate>@(context.Item.FinancialItem is null ? "-" : GetCalcLabel(context.Item.FinancialItem.CalculationType))</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="جزئیات">
                        <CellTemplate>@GetBillItemDetail(selectedBill, context.Item)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="مبلغ (ریال)">
                        <CellTemplate>@context.Item.Amount.ToString("N0")</CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="BillItem" />
                </PagerContent>
            </MudDataGrid>
            <MudText Typo="Typo.subtitle1" Class="mt-3">جمع کل: @selectedBill.BillItems.Sum(x => x.Amount).ToString("N0")</MudText>
        </MudPaper>
    </div>
}
