@page "/admin/reports"
@attribute [Authorize(Roles = "Administrator")]
@using ResidentialComplex.Application.DTOs

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">گزارشات مالی</MudText>
        <HelpButton PageKey="reports" />
    </MudStack>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadReportAsync">
        نمایش گزارش
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudNumericField T="int" @bind-Value="filterYear" Label="سال" Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="int" @bind-Value="filterMonth" Label="ماه (اختیاری)" Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="0">همه</MudSelectItem>
                @for (var month = 1; month <= 12; month++)
                {
                    <MudSelectItem T="int" Value="@month">@GetMonthName(month)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="int" @bind-Value="filterHouseId" Label="واحد (اختیاری)" Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="0">همه</MudSelectItem>
                @foreach (var house in houses)
                {
                    <MudSelectItem T="int" Value="@house.Id">@house.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadFiltersAsync">
                بروزرسانی فهرست
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (report is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4 mud-theme-primary"><MudText Typo="Typo.subtitle2">کل صورتحساب</MudText><MudText Typo="Typo.h5">@report.TotalBilled.ToString("N0")</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.subtitle2">کل پرداخت</MudText><MudText Typo="Typo.h5" Color="Color.Success">@report.TotalPaid.ToString("N0")</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.subtitle2">بدهی معوق</MudText><MudText Typo="Typo.h5" Color="Color.Error">@report.OutstandingDebt.ToString("N0")</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Typo="Typo.subtitle2">نرخ وصول</MudText><MudText Typo="Typo.h5">@report.CollectionRate.ToString("N1")%</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">بدهی هر آپارتمان</MudText>
        <MudDataGrid T="ApartmentDebtDto" Items="@report.DebtPerApartment" RowsPerPage="10" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.ApartmentTitle" Title="آپارتمان" />
                <TemplateColumn Title="بدهی کل">
                    <CellTemplate>@context.Item.TotalDebt.ToString("N0")</CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ApartmentDebtDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">بدهی هر واحد</MudText>
        <MudDataGrid T="HouseDebtDto" Items="@report.DebtPerHouse" RowsPerPage="10" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.HouseTitle" Title="واحد" />
                <TemplateColumn Title="بدهی">
                    <CellTemplate>
                        <MudText Color="@(context.Item.CurrentDebt > 0 ? Color.Error : context.Item.CurrentDebt < 0 ? Color.Success : Color.Default)">
                            @context.Item.CurrentDebt.ToString("N0")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="HouseDebtDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">جزئیات ماهانه</MudText>
        <MudDataGrid T="MonthlyBreakdownDto" Items="@report.MonthlyBreakdown" RowsPerPage="10" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Year" Title="سال" />
                <TemplateColumn Title="ماه">
                    <CellTemplate>@GetMonthName(context.Item.Month)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="صورتحساب">
                    <CellTemplate>@context.Item.Billed.ToString("N0")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="پرداخت شده">
                    <CellTemplate>@context.Item.Paid.ToString("N0")</CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="MonthlyBreakdownDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
}
