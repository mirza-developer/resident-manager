@page "/admin/houses"
@attribute [Authorize(Roles = "Administrator")]
@using ResidentialComplex.Domain.Entities

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">مدیریت واحدها</MudText>
        <HelpButton PageKey="houses" />
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreate">
        افزودن واحد جدید
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="int" Label="فیلتر آپارتمان" Value="filterApartmentId" ValueChanged="OnApartmentFilterChanged" Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="0">همه آپارتمان‌ها</MudSelectItem>
                @foreach (var apartment in apartments)
                {
                    <MudSelectItem T="int" Value="@apartment.Id">@apartment.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                بروزرسانی
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4">
    <MudDataGrid T="House" Items="@filteredHouses" Filterable="true" SortMode="SortMode.Multiple" RowsPerPage="10" Hover="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.Title" Title="عنوان" />
            <PropertyColumn Property="x => x.Apartment!.Title" Title="آپارتمان" />
            <PropertyColumn Property="x => x.ResidentName" Title="ساکن" />
            <PropertyColumn Property="x => x.ResidentPhoneNumber" Title="تلفن" />
            <PropertyColumn Property="x => x.NumberOfResidents" Title="تعداد ساکنین" />
            <TemplateColumn Title="بدهی">
                <CellTemplate>
                    <MudText Color="@(context.Item.CurrentDebt > 0 ? Color.Error : context.Item.CurrentDebt < 0 ? Color.Success : Color.Default)">
                        @context.Item.CurrentDebt.ToString("N0")
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="وضعیت">
                <CellTemplate>
                    <MudChip T="string" Color="@(context.Item.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                        @(context.Item.IsActive ? "فعال" : "غیرفعال")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => NavigateToEdit(context.Item.Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteHouseAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>واحدی برای نمایش وجود ندارد.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="House" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
