@page "/admin/users"
@attribute [Authorize(Roles = "Administrator")]

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">مدیریت کاربران</MudText>
        <HelpButton PageKey="users" />
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreate">
        افزودن کاربر جدید
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

<MudPaper Class="pa-4">
    <MudDataGrid T="UserInfo" Items="@users" Filterable="true" SortMode="SortMode.Multiple" RowsPerPage="10" Hover="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.FullName" Title="نام" />
            <PropertyColumn Property="x => x.UserName" Title="نام کاربری" />
            <PropertyColumn Property="x => x.Role" Title="نقش" />
            <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => NavigateToEdit(context.Item.Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteUserAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>کاربری برای نمایش وجود ندارد.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="UserInfo" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
