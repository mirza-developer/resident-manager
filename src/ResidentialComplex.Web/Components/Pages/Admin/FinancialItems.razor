@page "/admin/financial-items"
@using Microsoft.AspNetCore.Authorization
@using ResidentialComplex.Application.Interfaces
@using ResidentialComplex.Domain.Entities
@using ResidentialComplex.Domain.Enums
@attribute [Authorize(Roles = "Administrator")]
@inject IFinancialItemRepository FinancialItemRepo

<h4>مدیریت آیتم‌های مالی</h4>
<HelpButton PageKey="financialItems" />

<button type="button" class="btn btn-success mb-3" @onclick="ShowAdd">افزودن آیتم مالی جدید</button>

@if (showForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>@(editing.Id == 0 ? "افزودن" : "ویرایش") آیتم مالی</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="mb-2">
                    <label class="form-label">عنوان *</label>
                    <InputText @bind-Value="editing.Title" class="form-control" />
                    <ValidationMessage For="() => editing.Title" />
                </div>
                <div class="mb-2">
                    <label class="form-label">توضیحات</label>
                    <InputText @bind-Value="editing.Description" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">نوع دوره</label>
                    <InputSelect @bind-Value="editing.PeriodType" class="form-select">
                        <option value="@PeriodType.Once">یکبار</option>
                        <option value="@PeriodType.Permanent">دائمی</option>
                        <option value="@PeriodType.Installment">اقساط</option>
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label class="form-label">نوع محاسبه</label>
                    <InputSelect @bind-Value="editing.CalculationType" class="form-select">
                        <option value="@CalculationType.EqualDivision">تقسیم مساوی</option>
                        <option value="@CalculationType.Grouping">تعرفه پلکانی (IBT)</option>
                    </InputSelect>
                </div>
                @if (editing.PeriodType == PeriodType.Installment)
                {
                    <div class="mb-2">
                        <label class="form-label">مبلغ کل</label>
                        <InputNumber @bind-Value="editing.TotalAmount" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">تعداد اقساط</label>
                        <InputNumber @bind-Value="editing.NumberOfInstallments" class="form-control" />
                    </div>
                }
                <div class="mb-2 form-check">
                    <InputCheckbox @bind-Value="editing.IsActive" class="form-check-input" id="fiActive" />
                    <label class="form-check-label" for="fiActive">فعال</label>
                </div>
                <button type="submit" class="btn btn-primary">ذخیره</button>
                <button type="button" class="btn btn-secondary" @onclick="() => showForm = false">انصراف</button>
            </EditForm>

            @if (editing.CalculationType == CalculationType.Grouping && editing.Id != 0)
            {
                <hr />
                <h6 class="mt-3">تعرفه‌های پلکانی (IBT)</h6>
                <p class="text-muted small">
                    تعرفه‌ها به ترتیب از کمترین مصرف تعریف می‌شوند. آخرین تعرفه حد بالایی ندارد (نامحدود).
                </p>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>حد بالای مصرف (واحد)</th>
                            <th>نرخ هر واحد (ریال)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int tierRow = 0; }
                        @foreach (var tier in editingTiers)
                        {
                            tierRow++;
                            var t = tier;
                            <tr>
                                <td>@tierRow</td>
                                <td>
                                    @if (t == editingTiers.Last())
                                    {
                                        <span class="text-muted">نامحدود</span>
                                    }
                                    else
                                    {
                                        <input type="number" class="form-control form-control-sm" style="max-width:120px;"
                                               value="@t.UpperLimit"
                                               @onchange="(e) => UpdateTierUpperLimit(t, e)" />
                                    }
                                </td>
                                <td>
                                    <input type="number" step="0.0001" class="form-control form-control-sm" style="max-width:140px;"
                                           value="@t.RatePerUnit"
                                           @onchange="(e) => UpdateTierRate(t, e)" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveTier(t)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddTierRow">+ افزودن تعرفه</button>
                <button type="button" class="btn btn-sm btn-success ms-2" @onclick="SaveTiers">ذخیره تعرفه‌ها</button>
                @if (!string.IsNullOrEmpty(tierMessage))
                {
                    <div class="alert @(tierIsError ? "alert-danger" : "alert-success") mt-2 py-1 px-2">@tierMessage</div>
                }
            }
            else if (editing.CalculationType == CalculationType.Grouping && editing.Id == 0)
            {
                <div class="alert alert-info mt-2">پس از ذخیره آیتم، می‌توانید تعرفه‌های پلکانی را تعریف کنید.</div>
            }
        </div>
    </div>
}

<table class="table table-striped table-bordered">
    <thead><tr><th>عنوان</th><th>نوع دوره</th><th>نوع محاسبه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody>
        @foreach (var fi in items)
        {
            <tr>
                <td>@fi.Title</td>
                <td>@GetPeriodLabel(fi.PeriodType)</td>
                <td>@GetCalcLabel(fi.CalculationType)</td>
                <td>@(fi.IsActive ? "فعال" : "غیرفعال")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-warning" @onclick="() => Edit(fi)">ویرایش</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => Delete(fi.Id)">حذف</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<FinancialItem> items = new();
    private FinancialItem editing = new();
    private bool showForm;

    // Tier editing state
    private List<TierRow> editingTiers = new();
    private string? tierMessage;
    private bool tierIsError;

    protected override async Task OnInitializedAsync() => items = await FinancialItemRepo.GetAllAsync();

    private void ShowAdd() { editing = new FinancialItem { IsActive = true }; editingTiers = new(); showForm = true; }

    private async Task Edit(FinancialItem fi)
    {
        editing = fi;
        editingTiers = fi.Tiers
            .OrderBy(t => t.TierOrder)
            .Select(t => new TierRow { Id = t.Id, UpperLimit = t.UpperLimit, RatePerUnit = t.RatePerUnit })
            .ToList();
        tierMessage = null;
        showForm = true;
    }

    private async Task Save()
    {
        if (editing.Id == 0) await FinancialItemRepo.AddAsync(editing);
        else await FinancialItemRepo.UpdateAsync(editing);
        items = await FinancialItemRepo.GetAllAsync();
        // Keep form open for Grouping items so tiers can be edited
        if (editing.CalculationType != CalculationType.Grouping)
            showForm = false;
        else
        {
            // Refresh editing reference so Id is populated for new items
            editing = items.First(i => i.Id == editing.Id);
            editingTiers = editing.Tiers
                .OrderBy(t => t.TierOrder)
                .Select(t => new TierRow { Id = t.Id, UpperLimit = t.UpperLimit, RatePerUnit = t.RatePerUnit })
                .ToList();
        }
    }

    private async Task Delete(int id)
    {
        await FinancialItemRepo.DeleteAsync(id);
        items = await FinancialItemRepo.GetAllAsync();
    }

    private void AddTierRow()
    {
        editingTiers.Add(new TierRow { UpperLimit = null, RatePerUnit = 0 });
        tierMessage = null;
    }

    private void RemoveTier(TierRow tier) { editingTiers.Remove(tier); tierMessage = null; }

    private void UpdateTierUpperLimit(TierRow tier, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) tier.UpperLimit = v;
    }

    private void UpdateTierRate(TierRow tier, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v)) tier.RatePerUnit = v;
    }

    private async Task SaveTiers()
    {
        if (editing.Id == 0) { tierMessage = "ابتدا آیتم مالی را ذخیره کنید."; tierIsError = true; return; }

        // Validate: only last tier may have null UpperLimit
        for (int i = 0; i < editingTiers.Count - 1; i++)
        {
            if (editingTiers[i].UpperLimit == null)
            {
                tierMessage = "تنها آخرین تعرفه می‌تواند بدون حد بالایی باشد.";
                tierIsError = true;
                return;
            }
        }

        // Validate: UpperLimit values must be strictly increasing
        for (int i = 1; i < editingTiers.Count - 1; i++)
        {
            if (editingTiers[i].UpperLimit <= editingTiers[i - 1].UpperLimit)
            {
                tierMessage = "حد بالایی هر تعرفه باید از تعرفه قبلی بزرگ‌تر باشد.";
                tierIsError = true;
                return;
            }
        }

        // Delete existing tiers from DB
        var existing = await FinancialItemRepo.GetTiersAsync(editing.Id);
        foreach (var t in existing)
            await FinancialItemRepo.DeleteTierAsync(t.Id);

        // Re-add in order
        for (int i = 0; i < editingTiers.Count; i++)
        {
            var row = editingTiers[i];
            await FinancialItemRepo.AddTierAsync(new FinancialItemTier
            {
                FinancialItemId = editing.Id,
                TierOrder = i + 1,
                UpperLimit = i < editingTiers.Count - 1 ? row.UpperLimit : null,
                RatePerUnit = row.RatePerUnit
            });
        }

        items = await FinancialItemRepo.GetAllAsync();
        editing = items.First(i => i.Id == editing.Id);
        editingTiers = editing.Tiers
            .OrderBy(t => t.TierOrder)
            .Select(t => new TierRow { Id = t.Id, UpperLimit = t.UpperLimit, RatePerUnit = t.RatePerUnit })
            .ToList();
        tierMessage = "تعرفه‌ها با موفقیت ذخیره شدند.";
        tierIsError = false;
    }

    private static string GetPeriodLabel(PeriodType pt) => pt switch { PeriodType.Once => "یکبار", PeriodType.Permanent => "دائمی", PeriodType.Installment => "اقساط", _ => "" };
    private static string GetCalcLabel(CalculationType ct) => ct switch { CalculationType.EqualDivision => "تقسیم مساوی", CalculationType.Grouping => "تعرفه پلکانی (IBT)", _ => "" };

    private class TierRow
    {
        public int Id { get; set; }
        public int? UpperLimit { get; set; }
        public decimal RatePerUnit { get; set; }
    }
}
