@page "/admin/financial-items"
@using Microsoft.AspNetCore.Authorization
@using ResidentialComplex.Application.Interfaces
@using ResidentialComplex.Domain.Entities
@using ResidentialComplex.Domain.Enums
@attribute [Authorize(Roles = "Administrator")]
@inject IFinancialItemRepository FinancialItemRepo

<h4>مدیریت آیتم‌های مالی</h4>
<HelpButton PageKey="financialItems" />

<button type="button" class="btn btn-success mb-3" @onclick="ShowAdd">افزودن آیتم مالی جدید</button>

@if (showForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>@(editing.Id == 0 ? "افزودن" : "ویرایش") آیتم مالی</h5>
            <EditForm Model="editing" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="mb-2">
                    <label class="form-label">عنوان *</label>
                    <InputText @bind-Value="editing.Title" class="form-control" />
                    <ValidationMessage For="() => editing.Title" />
                </div>
                <div class="mb-2">
                    <label class="form-label">توضیحات</label>
                    <InputText @bind-Value="editing.Description" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">نوع دوره</label>
                    <InputSelect @bind-Value="editing.PeriodType" class="form-select">
                        <option value="@PeriodType.Once">یکبار</option>
                        <option value="@PeriodType.Permanent">دائمی</option>
                        <option value="@PeriodType.Installment">اقساط</option>
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label class="form-label">نوع محاسبه</label>
                    <InputSelect @bind-Value="editing.CalculationType" class="form-select">
                        <option value="@CalculationType.EqualDivision">تقسیم مساوی</option>
                        <option value="@CalculationType.Grouping">گروه‌بندی</option>
                    </InputSelect>
                </div>
                @if (editing.PeriodType == PeriodType.Installment)
                {
                    <div class="mb-2">
                        <label class="form-label">مبلغ کل</label>
                        <InputNumber @bind-Value="editing.TotalAmount" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">تعداد اقساط</label>
                        <InputNumber @bind-Value="editing.NumberOfInstallments" class="form-control" />
                    </div>
                }
                @if (editing.CalculationType == CalculationType.Grouping)
                {
                    <div class="mb-2">
                        <label class="form-label">تعداد گروه‌ها</label>
                        <InputNumber @bind-Value="editing.NumberOfGroups" class="form-control" />
                    </div>
                }
                <div class="mb-2 form-check">
                    <InputCheckbox @bind-Value="editing.IsActive" class="form-check-input" id="fiActive" />
                    <label class="form-check-label" for="fiActive">فعال</label>
                </div>
                <button type="submit" class="btn btn-primary">ذخیره</button>
                <button type="button" class="btn btn-secondary" @onclick="() => showForm = false">انصراف</button>
            </EditForm>
        </div>
    </div>
}

<table class="table table-striped table-bordered">
    <thead><tr><th>عنوان</th><th>نوع دوره</th><th>نوع محاسبه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody>
        @foreach (var fi in items)
        {
            <tr>
                <td>@fi.Title</td>
                <td>@GetPeriodLabel(fi.PeriodType)</td>
                <td>@GetCalcLabel(fi.CalculationType)</td>
                <td>@(fi.IsActive ? "فعال" : "غیرفعال")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-warning" @onclick="() => Edit(fi)">ویرایش</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => Delete(fi.Id)">حذف</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<FinancialItem> items = new();
    private FinancialItem editing = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() => items = await FinancialItemRepo.GetAllAsync();

    private void ShowAdd() { editing = new FinancialItem { IsActive = true }; showForm = true; }
    private void Edit(FinancialItem fi) { editing = fi; showForm = true; }

    private async Task Save()
    {
        if (editing.Id == 0) await FinancialItemRepo.AddAsync(editing);
        else await FinancialItemRepo.UpdateAsync(editing);
        items = await FinancialItemRepo.GetAllAsync();
        showForm = false;
    }

    private async Task Delete(int id)
    {
        await FinancialItemRepo.DeleteAsync(id);
        items = await FinancialItemRepo.GetAllAsync();
    }

    private static string GetPeriodLabel(PeriodType pt) => pt switch { PeriodType.Once => "یکبار", PeriodType.Permanent => "دائمی", PeriodType.Installment => "اقساط", _ => "" };
    private static string GetCalcLabel(CalculationType ct) => ct switch { CalculationType.EqualDivision => "تقسیم مساوی", CalculationType.Grouping => "گروه‌بندی", _ => "" };
}
