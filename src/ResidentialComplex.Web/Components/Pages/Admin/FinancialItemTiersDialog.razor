@using System.Globalization
@using ResidentialComplex.Domain.Entities

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">تعرفه‌های مصرفی — @ItemTitle</MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                تعرفه‌ها را به هر ترتیبی که مایل باشید وارد کنید؛ سیستم به‌صورت خودکار بر اساس حد مصرف مرتب و اعتبارسنجی می‌کند.
                کل مصرف واحد فقط در یکی از این تعرفه‌ها قرار می‌گیرد و تمام مصرف با نرخ همان تعرفه محاسبه خواهد شد.
                یک ردیف را برای تعرفه نامحدود (بالاترین سطح) خالی بگذارید.
            </MudAlert>

            <MudDataGrid T="TierRow" Items="@rows" Hover="true" Dense="true" Elevation="0" Bordered="true" Class="mb-3">
                <Columns>
                    <TemplateColumn Title="#">
                        <CellTemplate>@(rows.IndexOf(context.Item) + 1)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="حد بالای مصرف (واحد)">
                        <CellTemplate>
                            <MudNumericField T="int?" @bind-Value="context.Item.UpperLimit" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Placeholder="نامحدود" Format="N0"
                                             Culture="@CultureInfo.InvariantCulture" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="نرخ هر واحد (ریال)">
                        <CellTemplate>
                            <MudNumericField T="decimal" @bind-Value="context.Item.RatePerUnit" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="N0" Culture="@CultureInfo.InvariantCulture" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveRow(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">
                افزودن تعرفه
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@isSaving">
            ذخیره تعرفه‌ها
        </MudButton>
    </DialogActions>
</MudDialog>
