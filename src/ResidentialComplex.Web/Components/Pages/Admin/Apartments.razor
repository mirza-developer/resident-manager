@page "/admin/apartments"
@attribute [Authorize(Roles = "Administrator")]
@using ResidentialComplex.Domain.Entities

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">مدیریت آپارتمان‌ها</MudText>
        <HelpButton PageKey="apartments" />
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreate">
        افزودن آپارتمان جدید
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

<MudPaper Class="pa-4">
    <MudDataGrid T="Apartment" Items="@apartments" Filterable="true" SortMode="SortMode.Multiple" RowsPerPage="10" Hover="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="شناسه" />
            <PropertyColumn Property="x => x.Title" Title="عنوان" />
            <PropertyColumn Property="x => x.Description" Title="توضیحات" />
            <PropertyColumn Property="x => x.Houses.Count" Title="تعداد واحد" />
            <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => NavigateToEdit(context.Item.Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteApartmentAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>آپارتمانی ثبت نشده است.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="Apartment" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
