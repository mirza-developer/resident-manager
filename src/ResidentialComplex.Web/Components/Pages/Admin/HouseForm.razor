@page "/admin/houses/create"
@page "/admin/houses/edit/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">@(IsEditMode ? "ویرایش واحد" : "ایجاد واحد")</MudText>
        <HelpButton PageKey="houses" />
    </MudStack>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
        بازگشت
    </MudButton>
</MudStack>

@if (isLoading)
{
    <div><MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" /></div>
}

@if (notFound)
{
    <div><MudAlert Severity="Severity.Warning" Dense="true">واحد موردنظر یافت نشد.</MudAlert></div>
}
else
{
    <div>
        <MudPaper Class="pa-4">
            <EditForm Model="house" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="house.Title" For="@(() => house.Title)" Label="عنوان *" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="int" @bind-Value="house.ApartmentId" Label="آپارتمان *" Variant="Variant.Outlined">
                            @foreach (var apartment in apartments)
                            {
                                <MudSelectItem T="int" Value="@apartment.Id">@apartment.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="house.ResidentName" For="@(() => house.ResidentName)" Label="نام ساکن *" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="house.ResidentPhoneNumber" For="@(() => house.ResidentPhoneNumber)" Label="شماره تلفن ساکن *" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int" @bind-Value="house.NumberOfResidents" For="@(() => house.NumberOfResidents)" Label="تعداد ساکنین" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        <MudCheckBox T="bool" @bind-Value="house.IsActive" Label="فعال" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
                        ذخیره
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="GoBack">
                        انصراف
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    </div>
}
