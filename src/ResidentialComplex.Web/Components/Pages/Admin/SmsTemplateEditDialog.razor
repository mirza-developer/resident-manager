<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">ویرایش قالب پیامک — @(template?.Title ?? "")</MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading || template is null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudTextField T="string" @bind-Value="template.Title" Label="عنوان قالب" Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField T="string" @bind-Value="template.Text" Label="متن پیامک" Variant="Variant.Outlined"
                          Lines="6" AutoGrow="true" Class="mb-2" />

            @if (placeholders.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">متغیرهای قابل استفاده</MudText>
                <MudText Typo="Typo.caption" Class="mb-2">
                    برای افزودن یک متغیر به انتهای متن، روی آن کلیک کنید. هنگام ارسال پیامک، هر متغیر با اطلاعات واقعی همان واحد جایگزین می‌شود.
                </MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                    @foreach (var placeholder in placeholders)
                    {
                        <MudTooltip Text="@placeholder.Description">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                                     OnClick="@(() => InsertPlaceholder(placeholder.Token))">
                                @placeholder.Token
                            </MudChip>
                        </MudTooltip>
                    }
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@(isSaving || template is null)">
            ذخیره
        </MudButton>
    </DialogActions>
</MudDialog>
