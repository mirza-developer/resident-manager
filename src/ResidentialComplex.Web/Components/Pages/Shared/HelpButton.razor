@using ResidentialComplex.Web.Components.Help

<MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.HelpOutline" OnClick="Toggle">
    @(isOpen ? "بستن راهنما" : "راهنما")
</MudButton>

@if (isOpen)
{
    <div class="help-overlay" @onclick="Toggle"></div>
    <MudPaper Class="help-drawer pa-4">
        <MudText Typo="Typo.h6">راهنما</MudText>
        <MudDivider Class="my-3" />
        @((MarkupString)HelpContent.GetContent(PageKey))
        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Toggle">بستن</MudButton>
    </MudPaper>
}
