@inherits LayoutComponentBase
@using ResidentialComplex.Application.Helpers

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">مدیریت مجتمع مسکونی</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <AuthorizeView Roles="Administrator">
                        <li class="nav-item"><a class="nav-link" href="/admin/apartments">آپارتمان‌ها</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/houses">واحدها</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/financial-items">آیتم‌های مالی</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/billing">صورتحساب</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/reports">گزارشات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/users">کاربران</a></li>
                    </AuthorizeView>
                    <AuthorizeView Roles="Worker">
                        <li class="nav-item"><a class="nav-link" href="/worker/usage">مصرف ماهانه</a></li>
                    </AuthorizeView>
                    <AuthorizeView Roles="Resident">
                        <li class="nav-item"><a class="nav-link" href="/resident/dashboard">پنل ساکن</a></li>
                    </AuthorizeView>
                </ul>
                <AuthorizeView>
                    <Authorized>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-light">@context.User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/api/account/logout">خروج</a>
                            </li>
                        </ul>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <main class="container-fluid flex-grow-1 py-3">
        @Body
    </main>

    <footer class="bg-light text-center py-2 mt-auto">
        <small class="text-muted">سیستم مدیریت مجتمع مسکونی &copy; @PersianCalendarHelper.GetCurrentYear()</small>
    </footer>
</div>
